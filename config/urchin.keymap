#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred";
};

&msc {
    delay-ms = <0>;
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

/ {
  behaviors {
    mt_none: mod_tap_none {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
        bindings = <&kp>, <&none>;
    };

    mt_bootloader: mod_tap_bootloader {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <200>;
        bindings = <&kp>, <&bootloader>;
    };
  };

  combos {
    compatible = "zmk,combos";
    // Finger-position combos intentionally apply on all layers.

    combo_left_escape {
        timeout-ms = <50>;
        key-positions = <10 11 12 13>;
        bindings = <&kp ESCAPE>;
    };

    combo_right_escape {
        timeout-ms = <50>;
        key-positions = <16 17 18 19>;
        bindings = <&kp ESCAPE>;
    };

    combo_left_return {
        timeout-ms = <50>;
        key-positions = <11 12>;
        bindings = <&kp RETURN>;
    };

    combo_right_return {
        timeout-ms = <50>;
        key-positions = <17 18>;
        bindings = <&kp RETURN>;
        layers = <0 1>;
    };

    combo_left_tab {
        timeout-ms = <50>;
        key-positions = <12 13>;
        bindings = <&kp TAB>;
    };

    combo_right_tab {
        timeout-ms = <50>;
        key-positions = <16 17>;
        bindings = <&kp TAB>;
        layers = <0 1>;
    };

    combo_scroll_down {
        timeout-ms = <10>;
        key-positions = <16 17>;
        bindings = <&msc SCRL_DOWN>;
        layers = <2>;
    };

    combo_scroll_up {
        timeout-ms = <10>;
        key-positions = <17 18>;
        bindings = <&msc SCRL_UP>;
        layers = <2>;
    };
  };

	keymap {
		compatible = "zmk,keymap";

		layer_0 {
			bindings = <
        &kp Q      &kp W      &kp E      &mt LSHIFT R &mt LCTRL  T &mt RCTRL Y &mt RSHIFT U &kp I      &kp O      &kp P
        &kp A      &kp S      &kp D      &kp F      &mt LALT G  &mt RALT H  &kp J      &kp K      &kp L      &kp SEMICOLON
        &kp Z      &kp X      &kp C      &kp V      &mt LGUI B  &mt RGUI N  &kp M      &kp COMMA  &kp DOT    &kp SLASH
                                        &lt 1 ESC  &kp SPACE   &kp BACKSPACE &mo 1
			>;
		};

		layer_1 {
			bindings = <
        &kp GRAVE  &kp SQT    &kp EQUAL  &mt LSHIFT MINUS &mt LCTRL BSLH &mt RCTRL HOME &mt RSHIFT  PG_DN &kp PG_UP  &kp END    &kp DEL
        &kp N1     &kp N2     &kp N3     &kp N4     &mt LALT N5 &mt RALT LEFT &kp DOWN   &kp UP     &kp RIGHT  &kp INS
        &kp N6     &kp N7     &kp N8     &kp N9     &mt LGUI N0 &mt_none RGUI 0 &none      &kp LBKT   &kp RBKT   &none
                                        &mo 2      &mt LSHIFT TAB &mt LSHIFT TAB      &mo 2
			>;
		};

		layer_2 {
			bindings = <
        &mkp LCLK  &mkp RCLK  &kp F11    &mt LSHIFT F12 &mt_bootloader LCTRL 0 &mt_bootloader RCTRL 0 &mt_none RSHIFT 0 &none      &none      &none
        &kp F1     &kp F2     &kp F3     &kp F4     &mt LALT F5 &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &mkp MCLK
        &kp F6     &kp F7     &kp F8     &kp F9     &mt LGUI F10 &mt_none RGUI 0 &none      &none      &none      &none
                                        &none      &none       &none      &none
			>;
		};
	};
};
